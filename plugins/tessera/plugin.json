{
  "name": "tessera",
  "version": "0.3.0",
  "title": "Network audio (Tessera)",
  "icon": "bi-soundwave",
  "min_ndimon": "1.4.0",
  "ui": "ui.html",
  "backup": null,
  "priv_commands": [
    "bundle-install",
    "bundle-uninstall",
    "write-flows",
    "write-alsa",
    "service",
    "enable",
    "disable",
    "write-pcms"
  ],
  "services": [
    "tesserad.service"
  ],
  "supplementary_groups": [
    "tessera",
    "tessera-admin"
  ],
  "readwrite_paths": [
    "/run/tessera"
  ],
  "config_files": [
    "/etc/tessera/config.d/60-ndimon.toml",
    "/etc/tessera/config.d/90-probe-flows.toml",
    "/etc/tessera/config.d/61-ndimon-flows.toml",
    "/etc/alsa/conf.d/60-ndimon-tessera.conf",
    "/etc/alsa/conf.d/61-ndimon-tessera-ranges.conf"
  ]
}
