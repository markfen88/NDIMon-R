{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Query",
  "oneOf": [
    {
      "type": "string",
      "enum": [
        "session",
        "state",
        "observed",
        "status",
        "health",
        "services",
        "watchdog_stats",
        "version",
        "vaapi_info",
        "hostname",
        "ntp",
        "reboot_schedule",
        "about_me",
        "audio_settings",
        "audio_status",
        "network_status",
        "network_profiles",
        "plugins",
        "plugin_feed",
        "refresh_plugin_feed",
        "tessera_status",
        "tessera_metrics",
        "tessera_diagnostics",
        "tessera_flows",
        "backup_snapshots",
        "events"
      ]
    },
    {
      "type": "object",
      "properties": {
        "state_domain": {
          "type": "object",
          "properties": {
            "domain": {
              "$ref": "#/$defs/Domain"
            }
          },
          "additionalProperties": false,
          "required": [
            "domain"
          ]
        }
      },
      "required": [
        "state_domain"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "catalog": {
          "type": "object",
          "properties": {
            "name": {
              "$ref": "#/$defs/Catalog"
            },
            "output": {
              "type": [
                "integer",
                "null"
              ],
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          },
          "additionalProperties": false,
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "catalog"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "output_audio": {
          "type": "object",
          "properties": {
            "output": {
              "type": "integer",
              "format": "uint8",
              "minimum": 0,
              "maximum": 255
            }
          },
          "additionalProperties": false,
          "required": [
            "output"
          ]
        }
      },
      "required": [
        "output_audio"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "network_pending": {
          "type": "object",
          "properties": {
            "token": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "token"
          ]
        }
      },
      "required": [
        "network_pending"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "preview_network": {
          "type": "object",
          "properties": {
            "profiles": {
              "$ref": "#/$defs/NetworkProfiles"
            }
          },
          "additionalProperties": false,
          "required": [
            "profiles"
          ]
        }
      },
      "required": [
        "preview_network"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "check_network_address": {
          "type": "object",
          "properties": {
            "address": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "address"
          ]
        }
      },
      "required": [
        "check_network_address"
      ],
      "additionalProperties": false
    },
    {
      "description": "Resolve/download a legacy feed or uploaded archive before confirmation.",
      "type": "object",
      "properties": {
        "prepare_plugin_install": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            },
            "source": {
              "type": "string"
            },
            "version": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "name",
            "source"
          ]
        }
      },
      "required": [
        "prepare_plugin_install"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "plugin_job": {
          "type": "object",
          "properties": {
            "job": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "job"
          ]
        }
      },
      "required": [
        "plugin_job"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "plugin_status": {
          "type": "object",
          "properties": {
            "name": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "name"
          ]
        }
      },
      "required": [
        "plugin_status"
      ],
      "additionalProperties": false
    },
    {
      "description": "The legacy encoder/subscription endpoints have no implementation.",
      "type": "object",
      "properties": {
        "unsupported": {
          "type": "object",
          "properties": {
            "what": {
              "type": "string"
            }
          },
          "additionalProperties": false,
          "required": [
            "what"
          ]
        }
      },
      "required": [
        "unsupported"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "export_backup": {
          "type": "object",
          "properties": {
            "scope": {
              "$ref": "#/$defs/RestoreScope"
            }
          },
          "additionalProperties": false,
          "required": [
            "scope"
          ]
        }
      },
      "required": [
        "export_backup"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "inspect_backup": {
          "type": "object",
          "properties": {
            "document": {
              "$ref": "#/$defs/BackupDocument"
            }
          },
          "additionalProperties": false,
          "required": [
            "document"
          ]
        }
      },
      "required": [
        "inspect_backup"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "Domain": {
      "type": "string",
      "enum": [
        "device",
        "outputs",
        "ndi",
        "audio",
        "network",
        "tessera",
        "display",
        "presets",
        "plugins"
      ]
    },
    "Catalog": {
      "type": "string",
      "enum": [
        "audio_endpoints",
        "ndi_sources",
        "network_interfaces",
        "display_modes"
      ]
    },
    "NetworkProfiles": {
      "description": "None backend + empty interface/networks/assignments means not adopted.\nImport the effective wired configuration before the first network mutation.",
      "type": "object",
      "properties": {
        "interface": {
          "type": "string"
        },
        "backend": {
          "anyOf": [
            {
              "$ref": "#/$defs/NetworkBackend"
            },
            {
              "type": "null"
            }
          ]
        },
        "networks": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/NetworkProfile"
          }
        },
        "roles": {
          "$ref": "#/$defs/NetworkRoles"
        },
        "confirm_policy": {
          "$ref": "#/$defs/ConfirmPolicy"
        }
      },
      "additionalProperties": false,
      "required": [
        "interface",
        "networks",
        "roles",
        "confirm_policy"
      ]
    },
    "NetworkBackend": {
      "type": "string",
      "enum": [
        "networkmanager",
        "networkd",
        "netplan",
        "ifupdown"
      ]
    },
    "NetworkProfile": {
      "type": "object",
      "properties": {
        "id": {
          "type": "string"
        },
        "name": {
          "type": "string"
        },
        "vlan_id": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "mode": {
          "$ref": "#/$defs/AddressMode"
        },
        "address": {
          "type": "string"
        },
        "prefix": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "gateway": {
          "type": "string"
        },
        "dns": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "dns_search": {
          "type": "array",
          "items": {
            "type": "string"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "id",
        "name",
        "mode",
        "address",
        "prefix",
        "gateway",
        "dns"
      ]
    },
    "AddressMode": {
      "type": "string",
      "enum": [
        "dhcp",
        "static"
      ]
    },
    "NetworkRoles": {
      "type": "object",
      "properties": {
        "management": {
          "type": "string"
        },
        "ndi": {
          "type": "string"
        },
        "audio": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "management",
        "ndi",
        "audio"
      ]
    },
    "ConfirmPolicy": {
      "type": "string",
      "enum": [
        "require_management_address",
        "token_only"
      ]
    },
    "RestoreScope": {
      "type": "string",
      "enum": [
        "all",
        "settings",
        "sources",
        "audio",
        "network",
        "display",
        "plugins"
      ]
    },
    "BackupDocument": {
      "type": "object",
      "properties": {
        "document": {
          "$ref": "#/$defs/DesiredState"
        },
        "assets": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/AssetRef"
          }
        },
        "legacy_sections": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "legacy_fingerprint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "document",
        "assets"
      ]
    },
    "DesiredState": {
      "type": "object",
      "properties": {
        "schema_version": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "revision": {
          "type": "integer",
          "format": "uint64",
          "minimum": 0
        },
        "device": {
          "$ref": "#/$defs/Device"
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^\\d+$": {
              "$ref": "#/$defs/Output"
            }
          }
        },
        "ndi": {
          "$ref": "#/$defs/Ndi"
        },
        "audio": {
          "$ref": "#/$defs/Audio"
        },
        "network": {
          "$ref": "#/$defs/NetworkProfiles"
        },
        "tessera": {
          "anyOf": [
            {
              "$ref": "#/$defs/Tessera"
            },
            {
              "type": "null"
            }
          ]
        },
        "display": {
          "$ref": "#/$defs/Display"
        },
        "presets": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/Preset"
          }
        },
        "plugins": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/PluginState"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "schema_version",
        "revision",
        "device",
        "outputs",
        "ndi",
        "audio",
        "network",
        "display",
        "presets",
        "plugins"
      ]
    },
    "Device": {
      "type": "object",
      "properties": {
        "hostname": {
          "type": "string"
        },
        "ndi_alias": {
          "type": "string"
        },
        "mode": {
          "$ref": "#/$defs/OperationMode"
        },
        "decode_mode": {
          "$ref": "#/$defs/DecodeMode"
        },
        "watchdog_mode": {
          "$ref": "#/$defs/WatchdogMode"
        },
        "ntp_server": {
          "type": "string"
        },
        "reboot_schedule": {
          "$ref": "#/$defs/RebootSchedule"
        },
        "about": {
          "$ref": "#/$defs/About"
        },
        "analog_audio_in_gain": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "analog_audio_out_gain": {
          "type": "integer",
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "plugin_feeds": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "allow_insecure_feeds": {
          "type": "boolean"
        },
        "web_allowed_hosts": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "default": []
        }
      },
      "additionalProperties": false,
      "required": [
        "hostname",
        "ndi_alias",
        "mode",
        "decode_mode",
        "watchdog_mode",
        "ntp_server",
        "reboot_schedule",
        "about",
        "analog_audio_in_gain",
        "analog_audio_out_gain",
        "plugin_feeds",
        "allow_insecure_feeds"
      ]
    },
    "OperationMode": {
      "type": "string",
      "enum": [
        "decode",
        "encode"
      ]
    },
    "DecodeMode": {
      "type": "string",
      "enum": [
        "auto",
        "hardware",
        "software"
      ]
    },
    "WatchdogMode": {
      "type": "string",
      "enum": [
        "disabled",
        "passive",
        "active"
      ]
    },
    "RebootSchedule": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "time": {
          "type": "string"
        },
        "days": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/Weekday"
          }
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "time",
        "days"
      ]
    },
    "Weekday": {
      "type": "string",
      "enum": [
        "sun",
        "mon",
        "tue",
        "wed",
        "thu",
        "fri",
        "sat"
      ]
    },
    "About": {
      "type": "object",
      "properties": {
        "group_name": {
          "type": "string"
        },
        "mac_address": {
          "type": "string"
        },
        "device_name": {
          "type": "string"
        },
        "host_name": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "group_name",
        "mac_address",
        "device_name",
        "host_name"
      ]
    },
    "Output": {
      "type": "object",
      "properties": {
        "alias": {
          "type": "string"
        },
        "source": {
          "anyOf": [
            {
              "$ref": "#/$defs/NdiSourceRef"
            },
            {
              "type": "null"
            }
          ]
        },
        "video": {
          "$ref": "#/$defs/OutputVideo"
        },
        "screensaver": {
          "$ref": "#/$defs/ScreenSaver"
        },
        "source_selection": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "alias",
        "video",
        "screensaver",
        "source_selection"
      ]
    },
    "NdiSourceRef": {
      "type": "object",
      "properties": {
        "name": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        }
      },
      "additionalProperties": false,
      "required": [
        "name",
        "endpoint"
      ]
    },
    "OutputVideo": {
      "type": "object",
      "properties": {
        "resolution": {
          "$ref": "#/$defs/Resolution"
        },
        "scale_mode": {
          "$ref": "#/$defs/ScaleMode"
        },
        "rotation": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        }
      },
      "additionalProperties": false,
      "required": [
        "resolution",
        "scale_mode",
        "rotation"
      ]
    },
    "Resolution": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "auto"
          ]
        },
        {
          "type": "object",
          "properties": {
            "mode": {
              "type": "object",
              "properties": {
                "width": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "height": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                },
                "refresh_hz": {
                  "type": "number",
                  "format": "double"
                }
              },
              "additionalProperties": false,
              "required": [
                "width",
                "height",
                "refresh_hz"
              ]
            }
          },
          "required": [
            "mode"
          ],
          "additionalProperties": false
        }
      ]
    },
    "ScaleMode": {
      "type": "string",
      "enum": [
        "letterbox",
        "stretch",
        "crop"
      ]
    },
    "ScreenSaver": {
      "type": "string",
      "enum": [
        "splash",
        "black",
        "capture"
      ]
    },
    "Ndi": {
      "type": "object",
      "properties": {
        "receive": {
          "$ref": "#/$defs/Transport"
        },
        "discovery_servers": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "groups": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "off_subnet_sources": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "tally": {
          "$ref": "#/$defs/TallyMode"
        },
        "color_space": {
          "$ref": "#/$defs/ColorSpace"
        },
        "receiver_advertising": {
          "type": "boolean",
          "default": true
        },
        "remote_control": {
          "type": "boolean",
          "default": true
        }
      },
      "additionalProperties": false,
      "required": [
        "receive",
        "discovery_servers",
        "groups",
        "off_subnet_sources",
        "tally",
        "color_space"
      ]
    },
    "Transport": {
      "type": "string",
      "enum": [
        "rudp",
        "multicast",
        "multi_tcp",
        "udp",
        "tcp"
      ]
    },
    "TallyMode": {
      "type": "string",
      "enum": [
        "on",
        "off",
        "video"
      ]
    },
    "ColorSpace": {
      "type": "string",
      "enum": [
        "yuv",
        "rgb"
      ]
    },
    "Audio": {
      "description": "One graph for both engines. Node gain/delay/mix retain v1 factorization,\nincluding inactive settings; v2 routes are the concrete runtime authority.",
      "type": "object",
      "properties": {
        "engine": {
          "$ref": "#/$defs/AudioEngine"
        },
        "settings": {
          "$ref": "#/$defs/AudioEngineSettings"
        },
        "sources": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AudioSource"
          }
        },
        "sinks": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AudioSink"
          }
        },
        "outputs": {
          "type": "object",
          "additionalProperties": false,
          "patternProperties": {
            "^\\d+$": {
              "$ref": "#/$defs/OutputAudio"
            }
          }
        },
        "routes": {
          "type": "object",
          "additionalProperties": {
            "$ref": "#/$defs/AudioRoute"
          }
        },
        "video_delay_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "engine",
        "settings",
        "sources",
        "sinks",
        "outputs",
        "routes",
        "video_delay_ms"
      ]
    },
    "AudioEngine": {
      "type": "string",
      "enum": [
        "v1",
        "v2"
      ]
    },
    "AudioEngineSettings": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "rate": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "period_frames": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "master": {
          "type": "string"
        },
        "memory_budget_mib": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "enabled",
        "rate",
        "period_frames",
        "master",
        "memory_budget_mib"
      ]
    },
    "AudioSource": {
      "type": "object",
      "properties": {
        "kind": {
          "$ref": "#/$defs/EndpointType"
        },
        "enabled": {
          "type": "boolean"
        },
        "channels": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "output": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint8",
          "minimum": 0,
          "maximum": 255
        },
        "alsa_pcm": {
          "type": [
            "string",
            "null"
          ]
        },
        "endpoint": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "channel_start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "channel_count": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "gain_db": {
          "type": "number",
          "format": "double"
        },
        "delay_ms": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        }
      },
      "additionalProperties": false,
      "required": [
        "kind",
        "enabled",
        "channels",
        "endpoint",
        "resource",
        "channel_start",
        "channel_count",
        "gain_db",
        "delay_ms"
      ]
    },
    "EndpointType": {
      "type": "string",
      "enum": [
        "ndi",
        "alsa"
      ]
    },
    "AudioSink": {
      "type": "object",
      "properties": {
        "enabled": {
          "type": "boolean"
        },
        "channels": {
          "type": "integer",
          "format": "uint16",
          "minimum": 0,
          "maximum": 65535
        },
        "alsa_pcm": {
          "type": "string"
        },
        "endpoint": {
          "type": "string"
        },
        "resource": {
          "type": "string"
        },
        "channel_start": {
          "type": "integer",
          "format": "uint32",
          "minimum": 0
        },
        "channel_count": {
          "type": "integer",
          "format": "uint16",
