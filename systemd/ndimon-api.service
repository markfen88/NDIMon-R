[Unit]
Description=NDIMon-R REST API
After=network-online.target ndimon-net-boot.service ndimon-r.service
Requires=ndimon-net-boot.service
Wants=network-online.target

[Service]
Type=simple
User=ndimon
Group=ndimon
Restart=always
RestartSec=3
WorkingDirectory=NDIMON_INSTALL_DIR/api
ExecStart=/usr/bin/node server.js
Environment=PORT=80
# Port 80 without being root. sudo to ndimon-priv is allowed (no NoNewPrivileges).
AmbientCapabilities=CAP_NET_BIND_SERVICE
ProtectHome=true
ProtectSystem=strict
ReadWritePaths=/etc /tmp /opt/ndimon-r /var/tmp /var/lib/ndimon -/run/ndimon -/var/lib/ndimon-network

[Install]
WantedBy=multi-user.target
