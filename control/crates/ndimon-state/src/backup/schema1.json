        "auth": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "salt",
            "hash"
          ],
          "allOf": [
            {
              "if": {
                "required": [
                  "algo"
                ],
                "properties": {
                  "algo": {
                    "const": "argon2id"
                  }
                }
              },
              "then": {
                "required": [
                  "phc"
                ]
              }
            }
          ],
          "properties": {
            "salt": {
              "type": "string",
              "pattern": "^[0-9a-f]{32}$"
            },
            "hash": {
              "type": "string",
              "pattern": "^[0-9a-f]{64}$"
            },
            "algo": {
              "enum": [
                "scrypt",
                "argon2id"
              ]
            },
            "phc": {
              "type": "string",
              "maxLength": 512,
              "pattern": "^\\$argon2id\\$v=19\\$m=[0-9]+,t=[0-9]+,p=[0-9]+\\$[A-Za-z0-9+/]{8,128}\\$[A-Za-z0-9+/]{16,128}$"
            }
          }
        }
      }
    }
  }
}
