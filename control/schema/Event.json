{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Event",
  "oneOf": [
    {
      "type": "object",
      "properties": {
        "state_changed": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "domains": {
              "type": "array",
              "items": {
                "$ref": "#/$defs/Domain"
              }
            },
            "origin": {
              "$ref": "#/$defs/Origin"
            }
          },
          "additionalProperties": false,
          "required": [
            "revision",
            "domains",
            "origin"
          ]
        }
      },
      "required": [
        "state_changed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "apply_progress": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "step": {
              "type": "string"
            },
            "status": {
              "$ref": "#/$defs/ApplyStatus"
            },
            "detail": {
              "type": [
                "string",
                "null"
              ]
            }
          },
          "additionalProperties": false,
          "required": [
            "revision",
            "step",
            "status"
          ]
        }
      },
      "required": [
        "apply_progress"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "observed": {
          "type": "object",
          "properties": {
            "domain": {
              "$ref": "#/$defs/Domain"
            },
            "delta": {
              "$ref": "#/$defs/DomainObserved"
            }
          },
          "additionalProperties": false,
          "required": [
            "domain",
            "delta"
          ]
        }
      },
      "required": [
        "observed"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "drift": {
          "type": "object",
          "properties": {
            "domain": {
              "$ref": "#/$defs/Domain"
            },
            "path": {
              "type": "string"
            },
            "artifact": {
              "type": [
                "string",
                "null"
              ]
            },
            "foreign": {
              "type": [
                "string",
                "null"
              ]
            },
            "selector": {
              "type": "string"
            },
            "interface": {
              "type": "string"
            },
            "neutralized": {
              "type": "boolean"
            },
            "blocking": {
              "type": "boolean"
            }
          },
          "additionalProperties": false,
          "required": [
            "domain",
            "path"
          ]
        }
      },
      "required": [
        "drift"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "network_pending": {
          "type": "object",
          "properties": {
            "revision": {
              "type": "integer",
              "format": "uint64",
              "minimum": 0
            },
            "expires_at": {
              "type": "string"
            },
            "phase": {
              "$ref": "#/$defs/NetworkPhase"
            }
          },
          "additionalProperties": false,
          "required": [
            "revision",
            "expires_at",
            "phase"
          ]
        }
      },
      "required": [
        "network_pending"
      ],
      "additionalProperties": false
    },
    {
      "type": "object",
      "properties": {
        "status": {
          "type": "object",
          "properties": {
            "source": {
              "$ref": "#/$defs/StatusSource"
            },
            "data": true
          },
          "additionalProperties": false,
          "required": [
            "source",
            "data"
          ]
        }
      },
      "required": [
        "status"
      ],
      "additionalProperties": false
    }
  ],
  "$defs": {
    "Domain": {
      "type": "string",
      "enum": [
        "device",
        "outputs",
        "ndi",
        "audio",
        "network",
        "tessera",
        "display",
        "presets",
        "plugins"
      ]
    },
    "Origin": {
      "oneOf": [
        {
          "type": "string",
          "enum": [
            "boot",
            "migration"
          ]
        },
        {
          "type": "object",
          "properties": {
            "ui": {
              "type": "object",
              "properties": {
                "session": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "session"
              ]
            }
          },
          "required": [
            "ui"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "cli": {
              "type": "object",
              "properties": {
                "uid": {
                  "type": "integer",
                  "format": "uint32",
                  "minimum": 0
                }
              },
              "additionalProperties": false,
              "required": [
                "uid"
              ]
            }
          },
          "required": [
            "cli"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "plugin": {
              "type": "object",
              "properties": {
                "name": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "name"
              ]
            }
          },
          "required": [
            "plugin"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "tessera": {
              "type": "object",
              "properties": {
                "peer": {
                  "type": "string"
                }
              },
              "additionalProperties": false,
              "required": [
                "peer"
              ]
            }
          },
          "required": [
            "tessera"
          ],
          "additionalProperties": false
        },
        {
          "description": "A Discovery Server controller routed an output (the SDK already switched it).",
          "type": "string",
          "const": "discovery_server"
        }
      ]
    },
    "ApplyStatus": {
      "type": "string",
      "enum": [
        "started",
        "done",
        "failed"
      ]
    },
    "DomainObserved": {
      "type": "object",
      "properties": {
        "status": {
          "$ref": "#/$defs/SyncStatus"
        },
        "applied_revision": {
          "type": [
            "integer",
            "null"
          ],
          "format": "uint64",
          "minimum": 0
        },
        "detail": {
          "type": [
            "string",
            "null"
          ]
        }
      },
      "additionalProperties": false,
      "required": [
        "status"
      ]
    },
    "SyncStatus": {
      "type": "string",
      "enum": [
        "in_sync",
        "applying",
        "pending_restart",
        "pending_confirmation",
        "failed",
        "drift"
      ]
    },
    "NetworkPhase": {
      "type": "string",
      "enum": [
        "staged",
        "applying",
        "applied",
        "confirmed",
        "reverting",
        "reverted",
        "expired",
        "failed"
      ]
    },
    "StatusSource": {
      "type": "string",
      "enum": [
        "decoder",
        "finder",
        "tessera",
        "network",
        "services"
      ]
    }
  }
}
