[Unit]
Description=NDIMon-R (Hardware NDI Decoder)
After=network-online.target
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=15
WatchdogSec=30
Restart=always
RestartSec=3
# Unbind all framebuffer consoles so DRM app can take display master
ExecStartPre=-/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon0/bind'
ExecStartPre=-/bin/sh -c 'echo 0 > /sys/class/vtconsole/vtcon1/bind'
ExecStartPre=-/bin/sh -c 'echo 1 > /sys/class/graphics/fb0/blank'
# RK3588 only: faster global ondemand response; original value restored at stop.
ExecStartPre=-/usr/bin/python3 -I /usr/local/lib/ndimon/ndimon-cpu-sampling apply
ExecStart=/usr/local/bin/ndimon-r
ExecStopPost=-/usr/bin/python3 -I /usr/local/lib/ndimon/ndimon-cpu-sampling restore
ExecStopPost=-/bin/sh -c 'echo 1 > /sys/class/vtconsole/vtcon0/bind'
ExecStopPost=-/bin/sh -c 'echo 1 > /sys/class/vtconsole/vtcon1/bind'
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/aarch64-linux-gnu:/usr/lib/x86_64-linux-gnu
# Share /var/lib/ndimon/.ndi with ndimon-finder. The SDK ignores $HOME (it uses the
# passwd home, /root for this service); NDI_CONFIG_DIR is the documented override.
Environment=HOME=/var/lib/ndimon
Environment=NDI_CONFIG_DIR=/var/lib/ndimon/.ndi
NoNewPrivileges=true
# High priority for real-time video
Nice=-10

[Install]
WantedBy=default.target
