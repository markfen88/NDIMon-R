[Unit]
Description=Import legacy NDIMon-R state before native ownership starts
Before=ndimon-control.service ndimon-r.service ndimon-finder.service

[Service]
Type=oneshot
User=root
Group=root
ExecStart=/usr/bin/ndimon-state-import
RemainAfterExit=yes
UMask=0027
NoNewPrivileges=yes
ProtectHome=yes
ProtectSystem=strict
# Create immutable legacy backups and hand the state directory to control.
ReadWritePaths=/etc /var/lib/ndimon/state /var/lib/ndimon/assets -/var/lib/tessera -/var/lib/ndimon-network
