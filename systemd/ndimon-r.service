[Unit]
Description=NDIMon-R (Hardware NDI Decoder)
# Never stop restarting: the device must recover without an operator (the
# former shell watchdog revived units that systemd had given up on).
StartLimitIntervalSec=0
Requires=ndimon-control.service ndimon-net-boot.service
After=network-online.target ndimon-control.service ndimon-net-boot.service
Wants=network-online.target

[Service]
Type=notify
TimeoutStartSec=15
WatchdogSec=30
Restart=always
RestartSec=3
# Unbind all framebuffer consoles so DRM app can take display master
ExecStartPre=-/usr/bin/ndimon-package console-acquire
# RK3588 only: faster global ondemand response; original value restored at stop.
ExecStartPre=-/usr/libexec/ndimon/ndimon-privd --cpu apply
ExecStart=/usr/bin/ndimon-r
ExecStopPost=-/usr/libexec/ndimon/ndimon-privd --cpu restore
ExecStopPost=-/usr/bin/ndimon-package console-release
Environment=LD_LIBRARY_PATH=/usr/local/lib:/usr/lib/aarch64-linux-gnu:/usr/lib/x86_64-linux-gnu
# Private SDK copy: the SDK uses the passwd home unless NDI_CONFIG_DIR is set.
Environment=NDIMON_FONT_DIR=/usr/share/ndimon/fonts
Environment=HOME=/var/lib/ndimon
Environment=NDI_CONFIG_DIR=/run/ndimon/ndi/decoder/
NoNewPrivileges=true
# High priority for real-time video
Nice=-10

[Install]
WantedBy=multi-user.target
